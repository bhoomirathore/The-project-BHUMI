# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bhumi_db?schema=public"

# JWT Secrets (Generate strong random 64-char strings in production)
JWT_SECRET=bhumi_jwt_super_secret_access_key_2026_change_in_production
JWT_REFRESH_SECRET=bhumi_jwt_super_secret_refresh_key_2026_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email / SMTP Configuration for Password Reset (Optional in dev, falls back to secure logged links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="B.H.U.M.I. Security <no-reply@bhumi.gov.in>"

# Pinata IPFS (Optional for document storage)
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_API_KEY=YOUR_PINATA_SECRET_API_KEY
PINATA_GATEWAY_URL=https://gateway.pinata.cloud
